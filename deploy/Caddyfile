# Skyloom on one host: TLS (automatic Let's Encrypt), the relay at /mp, the app
# everywhere else. Caddy proxies the WebSocket upgrade as is and sets
# X-Forwarded-For, which the relay reads because Caddy's peer is loopback.
{$SKYLOOM_DOMAIN} {
	handle /mp* {
		reverse_proxy 127.0.0.1:8787
	}
	handle {
		encode zstd gzip
		reverse_proxy 127.0.0.1:3000
	}
}
