# Copy to deploy/relay.env (never committed) on the server that runs the relay.
# Needed when the game is served from another site than the relay, e.g. the
# game on Netlify and the relay on CloudPanel at mp.your-domain.com.
#
# Which pages may connect: your game's address, plus (optional) Netlify's
# deploy previews and branch deploys, which look like https://<name>--<site>.netlify.app
MP_ORIGINS=https://your-site.netlify.app,https://*--your-site.netlify.app
# If your game uses its own domain on Netlify, list that instead (or as well):
# MP_ORIGINS=https://skyloom.example.com,https://your-site.netlify.app
